ks (down to the floor of segments / 3). Free: it only costs a bay slot","hides":1,"layer":4,"cost":0,"slot":"bay"},"flare_mask":{"note":"shrinks the flash when this ship fires, launches or uses point defence","flare_reduction":1,"layer":4,"cost":5,"slot":"bay"},"magazine":{"note":"stores missiles and drones for the ship's launchers","holds":3,"layer":4,"cost":3,"slot":"bay"},"comms":{"note":"long-range link; lose it and your fleet may split into islands","link_range":12,"layer":4,"cost":5,"slot":"bay"},"coupling":{"note":"joins a segment to the ship; one needed for every segment after the first","couples":true,"layer":4,"cost":0,"slot":"bay"},"shield":{"note":"soaks the first hit on its segment each round, then comes back","hp":1,"recharges":true,"layer":1,"cost":8,"slot":"mount"},"armour":{"note":"plates that soak hits; they do not come back","hp":2,"layer":2,"cost":5,"slot":"mount"},"laser":{"note":"instant, straight line, needs a clear line to a target the ship's network can see","hits":2,"range":8,"loses_1_hit_every":4,"layer":3,"cost":10,"slot":"mount"},"launcher":{"note":"launches missiles and drones stored in the ship's magazines","launches":true,"layer":3,"cost":4,"slot":"mount"},"point_defence":{"note":"automatic: stops an enemy missile or drone about to hit this ship; lights the ship up","stops_per_round":1,"layer":3,"cost":7,"slot":"mount"}},"munitions":{"missile":{"speed":6,"fuel":3,"turn_rate":1,"hits":3,"blast_radius":1,"seeker_range":2,"cost":8},"seeker_drone":{"speed":3,"fuel":6,"sensor_range":3,"patrol":"random","hits":2,"blast_radius":1,"reports":true,"reveals_itself_on_detect":true,"remote_detonate":true,"cost":6},"mine":{"speed":0,"hits":4,"blast_radius":0,"signature":-6,"setup_only":true,"max_per_player":6,"cost":5}},"fleet":[{"name":"Blob A","flagship":false,"load":{},"hull":[{"at":[-1,0],"bays":["engine","stealth","coupling"],"mounts":["armour"]},{"at":[0,0],"bays":["core","engine","coupling"]},{"at":[1,0],"bays":["sensor","engine","stealth"],